---
import Layout from "../layouts/Layout.astro";
import { BlinkingLight } from "../components/blinking-light";

const tubLight =
  "mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 50%, rgba(0,0,0,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 50%, rgba(0,0,0,0) 100%);";
const gridFade =
  "mask: radial-gradient(ellipse at center, black 30%, transparent 75%); -webkit-mask: radial-gradient(ellipse at center, black 30%, transparent 75%);";
const corners = [
  "left-[-3.5px] top-[-3.5px]",
  "right-[-3.5px] top-[-3.5px]",
  "left-[-3.5px] bottom-[-3.5px]",
  "right-[-3.5px] bottom-[-3.5px]",
];
---

<Layout>
  <main
    class="relative flex min-h-screen flex-col items-center overflow-hidden px-4 pt-16 font-inter bg-primary_bg text-primary_text"
    id="main-content"
    role="main"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgb(255_255_255/0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.05)_1px,transparent_1px)] bg-size-[64px_64px]"
      style={gridFade}
      aria-hidden="true"
    >
    </div>
    <BlinkingLight />
    <div
      class="relative h-1 w-[316px] animate-pulse bg-emerald-400"
      style={tubLight}
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mt-24 flex w-full max-w-xl flex-col items-center gap-6 border border-white/10 bg-black/30 px-6 py-12 text-center backdrop-blur-sm sm:px-12"
    >
      {
        corners.map((position) => (
          <div
            class={`absolute aspect-square h-1.5 rotate-45 bg-[#6ee7b7] ${position}`}
            aria-hidden="true"
          />
        ))
      }
      <p
        class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 font-mono text-xs tracking-widest text-emerald-300 uppercase"
      >
        Error 404
      </p>
      <h1
        class="bg-linear-to-b from-emerald-300 via-emerald-400 to-emerald-700 bg-clip-text text-8xl font-black tracking-tighter text-transparent sm:text-9xl"
      >
        404
      </h1>
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl font-semibold text-[#e6d4ff]">Page not found</h2>
        <p class="text-secondary_text">
          The page you're looking for doesn't exist or has been moved.
        </p>
      </div>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-md bg-emerald-400 px-5 py-2.5 font-medium text-black transition-colors hover:bg-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
        >
          Back to home
        </a>
        <a
          href="/#projects"
          class="rounded-md border border-white/15 px-5 py-2.5 font-medium transition-colors hover:border-emerald-400/60 hover:text-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
        >
          View projects
        </a>
      </div>
    </div>
  </main>
</Layout>
